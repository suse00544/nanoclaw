# Claude API Authentication
# Use EITHER Claude Code OAuth token OR Anthropic API key, not both
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Feishu/Lark Bot Configuration
# Create a self-built app at https://open.feishu.cn/app
# Enable bot capabilities - uses WebSocket long connection (no public URL needed)
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx

# Telegram Bot Configuration
# Get token from @BotFather
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Slack Bot Configuration
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# Discord Bot Configuration
# DISCORD_BOT_TOKEN=xxx

# Gmail Configuration
# GMAIL_CLIENT_ID=xxx
# GMAIL_CLIENT_SECRET=xxx
# GMAIL_REFRESH_TOKEN=xxx
