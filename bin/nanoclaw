#!/bin/zsh
PLIST=~/Library/LaunchAgents/com.nanoclaw.plist
LABEL=com.nanoclaw
LOG_DIR=~/nanoclaw/logs

is_running() {
  launchctl list "$LABEL" &>/dev/null
}

get_pid() {
  launchctl list | grep "$LABEL" | awk '{print $1}'
}

case "${1:-status}" in
  start)
    if is_running; then
      echo "✓ NanoClaw 已在运行 (PID $(get_pid))"
    else
      launchctl load "$PLIST" 2>/dev/null
      sleep 1
      if is_running; then
        echo "✓ NanoClaw 已启动 (PID $(get_pid))"
      else
        echo "✗ 启动失败，查看日志: $LOG_DIR/nanoclaw.error.log"
        exit 1
      fi
    fi
    ;;
  stop)
    if is_running; then
      launchctl unload "$PLIST" 2>/dev/null
      echo "✓ NanoClaw 已停止"
    else
      echo "NanoClaw 未在运行"
    fi
    ;;
  restart)
    launchctl kickstart -k "gui/$(id -u)/$LABEL" 2>/dev/null
    sleep 1
    echo "✓ NanoClaw 已重启 (PID $(get_pid))"
    ;;
  status)
    if is_running; then
      echo "✓ NanoClaw 运行中 (PID $(get_pid))"
    else
      echo "✗ NanoClaw 未运行"
    fi
    ;;
  logs)
    tail -f "$LOG_DIR/nanoclaw.log"
    ;;
  errors)
    tail -f "$LOG_DIR/nanoclaw.error.log"
    ;;
  build)
    cd /Users/bob/nanoclaw && npm run build
    ;;
  *)
    echo "用法: nanoclaw [start|stop|restart|status|logs|errors|build]"
    ;;
esac
