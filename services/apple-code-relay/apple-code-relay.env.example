HOST=127.0.0.1
PORT=8791
APPLE_CODE_TTL_SECONDS=300
APPLE_CODE_PUBLIC_URL=https://apple-code.example.com

# Generate these independently with: openssl rand -hex 32
APPLE_CODE_INGEST_TOKEN=
APPLE_CODE_VIEW_TOKEN=

# Option A: Feishu custom bot webhook. If set, it takes precedence over Option B.
FEISHU_WEBHOOK_URL=

# Option B: reuse NanoClaw's Feishu app credentials.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
FEISHU_DOMAIN=feishu
